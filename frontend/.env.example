# Vite reads THIS folder's .env — not .env.example.
# Copy:  cp .env.example .env
# Then set VITE_SKIN and restart: npm run dev
# Or preview without restart: /?skin=nord
#
# default     current look
# mhs         CRM purple
# nord        Arctic Frost (Polar Night)
# catppuccin  Latte / Mocha mauve
# tokyo       Tokyo Night
# github      GitHub Primer
# linear      Linear Magic Blue
# dracula     Alucard / Dracula purple
# rosepine    Rose Pine Dawn / Moon - soft and warm
# everforest  Soft forest green, easy on the eyes
# gruvbox     Retro warm, high contrast
# solarized   Solarized Light / Dark
# vercel      Geist near-monochrome, minimal
# gold-sweet  Black & champagne gold - soft and warm
# gold-rugged Black & brass - industrial, hard-edged
# gold-jewel  Obsidian & polished 24k - high-sheen luxury
# crm         Operations design system - purple on lavender
VITE_SKIN=default
